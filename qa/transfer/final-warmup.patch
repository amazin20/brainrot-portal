+ const heads=ends.map(e=>Math.max(0,levels[e.basin]-e.sill));
+ if(Math.abs(flowToEast)<.005){
+  if(Math.max(...heads)<.001)return 'ВОДА НИЖЕ ОБОИХ ОТВЕРСТИЙ';
